NODE_ENV=development
PORT=3000
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE?retryWrites=true&w=majority
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu
# Mỗi lần đổi giá trị này và redeploy, mật khẩu tài khoản Admin tự đổi theo.
ADMIN_PASSWORD=thay-bang-mat-khau-admin-manh-tu-10-den-72-ky-tu

# Hệ thống đổi điểm sang Robux (yêu cầu thủ công có admin duyệt)
ROBUX_REWARDS_ENABLED=false
ROBUX_POINTS_PER_ROBUX=100
ROBUX_MIN_REDEEM=10
ROBUX_MAX_DAILY=100
ROBUX_MAX_OPEN_REQUESTS=2

# AI chấm bài Ngữ văn - chỉ đặt ở Environment của máy chủ, không đưa vào HTML/GitHub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Lộ trình học tập. Lịch thật của trường có thể cập nhật qua API quản trị.
SCHOOL_YEAR=2026-2027


# Giải đấu cộng đồng. Chỉ dùng Điểm Đấu Trường không quy đổi tiền/Robux.
COMMUNITY_TOURNAMENTS_ENABLED=true
ARENA_WELCOME_POINTS=300
COMMUNITY_TOURNAMENT_MAX_ENTRY=500
COMMUNITY_TOURNAMENT_MAX_ACTIVE=2
COMMUNITY_TOURNAMENT_MAX_PLAYERS=32
COMMUNITY_TOURNAMENT_MAX_DAILY=5
